#!/bin/bash

# MediGuard Backend Automated Setup Script (Linux/macOS)
# This script automatically installs Python, UV, and sets up the MediGuard backend

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to detect OS
detect_os() {
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        if command_exists apt-get; then
            echo "ubuntu"
        elif command_exists dnf; then
            echo "fedora"
        elif command_exists pacman; then
            echo "arch"
        else
            echo "linux"
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    else
        echo "unknown"
    fi
}

# Function to install Python based on OS
install_python() {
    local os=$(detect_os)
    
    print_status "Installing Python..."
    
    case $os in
        "ubuntu")
            sudo apt update
            sudo apt install -y python3 python3-venv python3-pip
            ;;
        "fedora")
            sudo dnf install -y python3 python3-venv python3-pip
            ;;
        "arch")
            sudo pacman -S --noconfirm python python-pip
            ;;
        "macos")
            if ! command_exists brew; then
                print_status "Installing Homebrew first..."
                /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
                echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
                eval "$(/opt/homebrew/bin/brew shellenv)"
            fi
            brew install python
            ;;
        *)
            print_error "Unsupported operating system. Please install Python manually."
            exit 1
            ;;
    esac
    
    print_success "Python installed successfully!"
}

# Function to install UV
install_uv() {
    print_status "Installing UV (Python dependency manager)..."
    
    if curl -LsSf https://astral.sh/uv/install.sh | sh; then
        # Add UV to PATH for current session
        export PATH="$HOME/.cargo/bin:$PATH"
        print_success "UV installed successfully!"
    else
        print_error "Failed to install UV"
        exit 1
    fi
}

# Function to check Python installation
check_python() {
    if command_exists python3; then
        local version=$(python3 --version 2>&1 | grep -oE '[0-9]+\.[0-9]+')
        local major=$(echo $version | cut -d. -f1)
        local minor=$(echo $version | cut -d. -f2)
        
        if [[ $major -eq 3 && $minor -ge 10 ]]; then
            print_success "Python $version is already installed and compatible"
            return 0
        else
            print_warning "Python $version is installed but version 3.10+ is recommended"
            return 1
        fi
    elif command_exists python; then
        local version=$(python --version 2>&1 | grep -oE '[0-9]+\.[0-9]+')
        local major=$(echo $version | cut -d. -f1)
        local minor=$(echo $version | cut -d. -f2)
        
        if [[ $major -eq 3 && $minor -ge 10 ]]; then
            print_success "Python $version is already installed and compatible"
            return 0
        else
            print_warning "Python $version is installed but version 3.10+ is recommended"
            return 1
        fi
    else
        print_warning "Python is not installed"
        return 1
    fi
}

# Function to check UV installation
check_uv() {
    if command_exists uv; then
        print_success "UV is already installed"
        return 0
    else
        print_warning "UV is not installed"
        return 1
    fi
}

# Main setup function
main() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}  MediGuard Backend Setup${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    
    # Check and install Python
    if ! check_python; then
        install_python
    fi
    
    # Check and install UV
    if ! check_uv; then
        install_uv
    fi
    
    # Ensure we're in the correct directory
    if [[ ! -f "manage.py" ]]; then
        print_error "manage.py not found. Please run this script from the MediGuard backend directory."
        exit 1
    fi
    
    print_status "Setting up virtual environment and dependencies..."
    
    # Sync dependencies with UV
    if uv sync; then
        print_success "Dependencies installed successfully!"
    else
        print_error "Failed to install dependencies"
        exit 1
    fi
    
    print_success "Setup completed successfully!"
    echo ""
    echo -e "${GREEN}🎉 MediGuard backend is ready!${NC}"
    echo ""
    echo "To start the development server, run:"
    echo -e "${YELLOW}  uv run manage.py runserver${NC}"
    echo ""
    echo "Or activate the virtual environment and run:"
    echo -e "${YELLOW}  source .venv/bin/activate${NC}"
    echo -e "${YELLOW}  python manage.py runserver${NC}"
    echo ""
    echo "Then visit: http://127.0.0.1:8000/"
}

# Run main function
main "$@"