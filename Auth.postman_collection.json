{
	"info": {
		"name": "Auth",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Signup",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"url": {
					"raw": "http://127.0.0.1:8000/auth/users/",
					"protocol": "http",
					"host": ["127.0.0.1"],
					"port": "8000",
					"path": ["auth", "users", ""]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"bruce.wayne@example.com\",\n  \"password\": \"IamBatman@123\",\n  \"full_name\": \"Bruce Wayne\",\n  \"phone_number\": \"+9779800000000\",\n  \"address\": \"Wayne Manor, Gotham City\"\n}"
				}
			}
		},
		{
			"name": "Login",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"url": {
					"raw": "http://127.0.0.1:8000/auth/jwt/create/",
					"protocol": "http",
					"host": ["127.0.0.1"],
					"port": "8000",
					"path": ["auth", "jwt", "create", ""]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"bruce.wayne@example.com\",\n  \"password\": \"IamBatman@123\"\n}"
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json();",
							"",
							"if (res.access) {",
							"    pm.environment.set(\"access_token\", res.access);",
							"}",
							"if (res.refresh) {",
							"    pm.environment.set(\"refresh_token\", res.refresh);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Refresh",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"url": {
					"raw": "http://127.0.0.1:8000/auth/jwt/refresh/",
					"protocol": "http",
					"host": ["127.0.0.1"],
					"port": "8000",
					"path": ["auth", "jwt", "refresh", ""]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let res = pm.response.json();",
							"",
							"if (res.access) {",
							"    pm.environment.set(\"access_token\", res.access);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Info",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://127.0.0.1:8000/auth/users/me/",
					"protocol": "http",
					"host": ["127.0.0.1"],
					"port": "8000",
					"path": ["auth", "users", "me", ""]
				}
			}
		}
	]
}
